{
 "taxonomy": [
  {
   "id": "T01",
   "name": "/wordcup/ 以關鍵字網址量產娛樂城長尾頁",
   "type": "手法",
   "definition": "/wordcup/ 下一詞一頁（品牌、3a 修飾詞、空白變體），數千網址"
  },
  {
   "id": "T02",
   "name": "關鍵字頁共用內容模板",
   "type": "手法",
   "definition": "多頁同 H2／FAQ 骨架、固定開場句或第一人稱口吻，只換關鍵字"
  },
  {
   "id": "T03",
   "name": "FAQPage 結構化資料",
   "type": "手法",
   "definition": "頁面輸出 FAQPage JSON-LD 爭取複合式結果"
  },
  {
   "id": "T04",
   "name": "JSON-LD／og 混入無關 MLB 實體",
   "type": "現象",
   "definition": "JSON-LD 夾帶 MLB 戰績頁實體，或 og article:section 為 mlb今日戰績"
  },
  {
   "id": "T05",
   "name": "顯示日期與 meta／lastmod 不一致（新鮮度訊號）",
   "type": "手法",
   "definition": "頁面顯示或 JSON-LD 日期與 og／sitemap lastmod／網址日期對不上，含動態填近日"
  },
  {
   "id": "T06",
   "name": "雙 H1",
   "type": "現象",
   "definition": "同頁 2 個 H1（站名＋標題）或重複 H1"
  },
  {
   "id": "T07",
   "name": "nofollow 聯盟導流連結",
   "type": "手法",
   "definition": "連到 3a1788／wg1888 等註冊頁、帶 st= 參數、nofollow、無 sponsored、註冊 CTA"
  },
  {
   "id": "T08",
   "name": "全站選單錨文字導向 /wordcup/",
   "type": "手法",
   "definition": "選單「線上娛樂城推薦」等全站錨文字把各區連到 /wordcup/"
  },
  {
   "id": "T09",
   "name": "站內互連與聚合列表",
   "type": "手法",
   "definition": "相關推薦、側欄品牌連結、麵包屑、分類 hub、列表分頁等內鏈網"
  },
  {
   "id": "T10",
   "name": "/wordcup/ 獨立 sitemap 未宣告",
   "type": "手法",
   "definition": "/wordcup/sitemap.xml 不在 robots.txt／sitemap_index，靠探測才找到"
  },
  {
   "id": "T11",
   "name": "sitemap 落後或漏收新頁",
   "type": "現象",
   "definition": "REST 文章數或站上新頁（如 10/31）不在 sitemap，lastmod 停在 8 月"
  },
  {
   "id": "T12",
   "name": "sitemap 重複列與雜項",
   "type": "現象",
   "definition": "列數多於不重複網址、svg／kml／image:loc 等雜項入列"
  },
  {
   "id": "T13",
   "name": "網域重新註冊、承接舊政府站",
   "type": "手法",
   "definition": "2026-04-15 新註冊，Wayback 顯示原為 2030 智慧國家政策站"
  },
  {
   "id": "T14",
   "name": "舊網址／短碼／舊路徑沿用放新內容",
   "type": "手法",
   "definition": "有存檔或 301 佐證的舊 URL、短碼、舊資料夾現放運彩／博弈內容"
  },
  {
   "id": "T15",
   "name": "slug／錨文字與內容不符",
   "type": "現象",
   "definition": "政策風格 slug 或資料夾名放世足／MLB 內容、選單標籤與目標不符（未證實為舊站網址時歸此）"
  },
  {
   "id": "T16",
   "name": "/taiwanplus/、/mlb/ 程式化 MLB 賽事頁",
   "type": "手法",
   "definition": "日期＋隊伍網址、API 資料套版的每日 MLB 頁大量產出"
  },
  {
   "id": "T17",
   "name": "/digi_taiwan/ 世足單場模板頁",
   "type": "手法",
   "definition": "72–77 個世足單場頁，SportsEvent、第三方 API 資料"
  },
  {
   "id": "T18",
   "name": "運彩外殼：首頁與內容頁不放目標詞",
   "type": "手法",
   "definition": "首頁／內容區正文無「娛樂城」，只在 alt／選單出現，兩層結構"
  },
  {
   "id": "T19",
   "name": "批次發佈／lastmod 集中",
   "type": "現象",
   "definition": "lastmod 按月集中、秒級間隔、同日或同秒發佈、賽前集中"
  },
  {
   "id": "T20",
   "name": "兩個目標詞的專屬頁布局",
   "type": "手法",
   "definition": "/wordcup/娛樂城、/wordcup/3a娛樂城、列表頁的 title／H1／H2、canonical、index 對準關鍵字"
  },
  {
   "id": "T21",
   "name": "模板 meta 與標記缺陷",
   "type": "現象",
   "definition": "空 meta、base64 og:description、og:title Home 1、generator 版本不一、Organization 空、缺 alt、分類 og:title 取文章"
  },
  {
   "id": "T22",
   "name": "示範／重複頁可索引",
   "type": "現象",
   "definition": "home-2、community／community-2、sample-page 等留在 sitemap 或可索引"
  },
  {
   "id": "T23",
   "name": "分頁 canonical 指首頁／作者頁 noindex",
   "type": "現象",
   "definition": "/page/N 或分頁 canonical 指回首頁、作者頁 noindex"
  },
  {
   "id": "T24",
   "name": "單薄或擬人作者",
   "type": "現象",
   "definition": "小編妮妮、阿豪、2030編輯部等無實據作者資訊"
  },
  {
   "id": "T25",
   "name": "分類頁 meta 塞博弈／搜尋意圖字眼",
   "type": "手法",
   "definition": "運彩分類 meta 寫盤口、穩定收益、出金快速、開戶優惠、合法、MLB直播 ptt 等"
  },
  {
   "id": "T26",
   "name": "meta 自稱「老牌域名權重」",
   "type": "現象",
   "definition": "/topic/ 等頁 meta 自述老牌域名權重"
  },
  {
   "id": "T27",
   "name": "AI／CMS 未編輯殘留",
   "type": "現象",
   "definition": "「[外部連結建議」、URL Slug 指示文字、markdown 星號、簡體字等殘留"
  },
  {
   "id": "T28",
   "name": "低能見度關鍵字區塊",
   "type": "手法",
   "definition": "10px／低透明度關鍵字清單"
  },
  {
   "id": "T29",
   "name": "不相干 meta 文字",
   "type": "現象",
   "definition": "meta 為西文 WWE、College Baseball、圖例文字等"
  },
  {
   "id": "T30",
   "name": "品牌詞高頻重複",
   "type": "手法",
   "definition": "單頁目標詞出現數十次（3a 75／45 次、大頭家 49 次）"
  },
  {
   "id": "T31",
   "name": "社群訊號",
   "type": "現象",
   "definition": "15.8k Subscribers、sameAs 社群連結"
  },
  {
   "id": "T32",
   "name": "Google 驗證與追蹤設定",
   "type": "現象",
   "definition": "google-site-verification TXT、GT／GA4 tag"
  },
  {
   "id": "T33",
   "name": "世足／運彩分類與專題聚合頁",
   "type": "手法",
   "definition": "CollectionPage 專題分區、分頁、跨分區列文、多分類掛載"
  },
  {
   "id": "T34",
   "name": "薄頁／空正文",
   "type": "現象",
   "definition": "articleBody 空、/pdf/ 薄頁、承諾內容卻無內容"
  },
  {
   "id": "T35",
   "name": "無法驗證宣稱與過時即時標示",
   "type": "現象",
   "definition": "蒙地卡羅模擬、每日即時更新、LIVE／Update 3 mins ago 但為靜態"
  },
  {
   "id": "T36",
   "name": "改寫新聞與後台連結外露",
   "type": "現象",
   "definition": "og:image:alt 保留新聞原標題、內文含 wp-admin post.php 連結"
  }
 ],
